	(text "MC68008 (DIP-48)\nJ4: logic-analyser header (pins 21/22 GND)\nD7 = sticky BERR from GAL3\nBus NMI pulls both IPL lines (level 7)\nBus IRQ is level 2\nThe 68681 is level 5"
		(exclude_from_sim no)
		(at 37.338 38.354 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "3a12729a-08ec-5750-b4c0-1c2ec7cf4cc2")
	)
	(text "D2: power LED\nD3: lights at HALT\nD4: lights at RESET\nD7: lights at BERR"
		(exclude_from_sim no)
		(at 153.162 129.794 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "dc9d3375-711d-481c-a8c7-4e2203c5a4d1")
	)
	(text "NOTE: these are 9-resistor arrays.\nPretty hard to come by. Change to 8?\nRN2 should be on page DUART. ~BR should be on another resistor.\n10k for RXDA is too much in combination with a USB-to-TTL-serial module: 100k?"
		(exclude_from_sim no)
		(at 221.234 42.418 0)
