	)
	(text "GAL3 (U11) = busdbg.pld: bus PHI1/PHI2, R/W and RAM.RW, plus debug outputs. GAL2 = bridge.pld: PHI2 = CLK/8 (1 MHz), synchronous bus cycle, DTACK after PHI2 falls (XDTACK).\nAddress and write data buffers are enabled only during window cycles; the bus parks at $FFFF."
		(exclude_from_sim no)
		(at 25 32 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
