100 REM SIEVE OF ERATOSTHENES, PASTED AS ONE BLOCK
110 N=1000
120 DIM F(N)
130 C=0
140 FOR I=2 TO N
150 IF F(I) THEN 200
160 C=C+1
170 IF C<=20 THEN PRINT I;" ";
175 IF I*I>N THEN 200
180 FOR J=I*I TO N STEP I:F(J)=1:NEXT J
200 NEXT I
210 PRINT
220 PRINT C;" PRIMES BELOW ";N
230 A$="core68008":PRINT UCASE$(A$);" ";LEN(A$);" ";HEX$(PEEK($A0000));" ";BIN$(5)
240 DO:K=K+1:LOOP UNTIL K=3:PRINT "DO LOOP ";K
250 PRINT USING$("###.##",PI)
